#!/usr/bin/env bash
# Compatibility shim: this tool was renamed spec2code -> e3d-code. Existing scripts, cron jobs and
# configs that call `spec2code` keep working; new ones should call `e3d-code`.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" == /* ]] || _src="$_dir/$_src"
done
exec "$(cd "$(dirname "$_src")" && pwd)/e3d-code" "$@"
